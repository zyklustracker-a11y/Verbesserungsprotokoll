rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  Firestore-Regeln · Verbesserungsprotokoll
//
//  Einsetzen in: Firebase Console → Firestore Database → Regeln
//
//  Freigeschaltet ist genau ein Konto: die UID in isOwner().
//  Soll spaeter ein weiteres Konto Zugriff bekommen, dessen UID in der
//  Firebase Console unter Authentication → Users ablesen und die
//  Bedingung in isOwner() um ein zweites "||" erweitern.
//
//  Warum diese Bauart:
//  Die Regel prüft, WER fragt – nicht, wem ein Dokument gehört.
//  Die bestehenden Daten haben kein Besitzer-Feld, weil sie ohne
//  Login angelegt wurden. Eine Regel auf Dokumentebene
//  (z. B. resource.data.ownerId == request.auth.uid) würde deshalb
//  sämtliche Altdaten unzugänglich machen. So bleibt alles erhalten,
//  ohne dass ein einziges Dokument angefasst werden muss.
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.uid == 'iTzgizFufKfOYNuFgWzGAVTODfc2';
    }

    // Projekte samt Einträgen (Verbesserungsvorschläge mit Unternotizen)
    match /projects/{projectId} {
      allow read, write: if isOwner();

      match /entries/{entryId} {
        allow read, write: if isOwner();
      }
    }

    // Ursprüngliches Protokoll (Altbestand, vor der Projekt-Struktur)
    match /verbesserungsprotokoll/{docId} {
      allow read, write: if isOwner();
    }

    // App-Ideen inkl. Konzept- und Prompt-Texten
    match /appIdeas/{ideaId} {
      allow read, write: if isOwner();
    }

    // Gespeicherte Prompts (Bereich „App-Ideen")
    match /savedPrompts/{promptId} {
      allow read, write: if isOwner();
    }

    // To-dos
    match /todos/{todoId} {
      allow read, write: if isOwner();
    }

    // Gespeicherte Dateien: Sammlung aus Titel/Beschreibung, die Anhaenge
    // liegen als Base64 in der Subcollection "files". Getrennt gespeichert,
    // damit das 1-MB-Limit von Firestore je Datei gilt und die Liste ohne
    // die Anhaenge geladen werden kann.
    match /savedFiles/{fileId} {
      allow read, write: if isOwner();

      match /files/{blobId} {
        allow read, write: if isOwner();
      }
    }

    // Einstellungen, u. a. der GitHub-Token für die Hosting-Erkennung.
    // Der Token liegt hier bewusst und nicht in einer der anderen
    // Collections: der Backup-Viewer (backup.html) sichert nur projects,
    // appIdeas, todos und verbesserungsprotokoll, damit der Token nicht in
    // heruntergeladenen Backup-Dateien landet.
    match /settings/{settingId} {
      allow read, write: if isOwner();
    }

    // Alles andere ist gesperrt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
